generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADM
  FUNC
  USER
}

enum PaymentMethod {
  PIX
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TransactionType {
  SALE
  REFUND
  COST
}

enum ChatSender {
  USER
  ADM
  FUNC
  SYSTEM
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  googleId             String?   @unique @map("google_id")
  name                 String?
  role                 UserRole  @default(USER)
  phone                String?
  cpf                  String?
  avatarUrl            String?   @map("avatar_url")
  isActive             Boolean   @default(true) @map("is_active")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  // Lockout temporário por tentativas de login com senha errada — resetado a
  // cada login bem-sucedido. Não se aplica ao login via Google (não usa senha).
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  orders           Order[]
  soldStockItems   StockItem[]       @relation("StockSoldToUser")
  editedStockItems StockItem[]       @relation("StockItemLastEditedBy")
  accessUpdateLogs AccessUpdateLog[]
  createdCoupons   Coupon[]          @relation("CouponCreatedBy")
  reviews          Review[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

/**
 * Um registro por refresh token emitido — permite revogação individual
 * (logout) e detecção de reuso: a cada /auth/refresh o token usado é marcado
 * como revogado e um novo é criado (rotação). Se um token já revogado for
 * reapresentado, é sinal de furto e todas as sessões do usuário são revogadas.
 */
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/**
 * Solicitações de titular de dados (LGPD) recebidas pelo formulário público
 * "Direitos do Titular" do frontend — persistidas para que o DPO consiga
 * localizar e responder dentro do prazo legal (antes disso, ficavam só em log).
 */
model LgpdRequest {
  id         String    @id @default(uuid())
  protocol   String    @unique
  name       String
  email      String
  cpf        String?
  type       String
  message    String?   @db.Text
  ip         String?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("lgpd_requests")
}

model Product {
  id                      String   @id @default(uuid())
  title                   String
  description             String?
  imageUrl                String?  @map("image_url")
  price                   Decimal  @db.Decimal(10, 2)
  costPrice               Decimal? @map("cost_price") @db.Decimal(10, 2)
  // Custo usado no lugar de costPrice quando o pedido é atendido por uma vaga
  // manual (StockItem.isManual) — o custo real de entrega manual costuma variar
  // e é editado à parte, sem afetar o custo do estoque "normal" do produto.
  manualCostPrice         Decimal? @map("manual_cost_price") @db.Decimal(10, 2)
  stockQuantity           Int      @default(0) @map("stock_quantity")
  // Dias que o acesso vendido continua válido (ex: 30 para "1 mês") — usado para
  // decidir quem ainda "está no prazo" ao notificar clientes de uma atualização
  // de credenciais de conta compartilhada. Null = sem prazo definido (notifica todos).
  accessDurationDays      Int?     @map("access_duration_days")
  categoryId              String   @map("category_id")
  platformId              String   @map("platform_id")
  baratosSociaisServiceId String?  @map("baratos_sociais_service_id")
  profitMarginPercent     Decimal  @default(0) @map("profit_margin_percent") @db.Decimal(5, 2)
  isActive                Boolean  @default(true) @map("is_active")
  // Controle manual do ADM/FUNC sobre a seção "Em destaque" da loja — não é
  // derivado de vendas/estoque, é decidido explicitamente por quem gerencia o catálogo.
  isFeatured              Boolean  @default(false) @map("is_featured")
  // Quando true, as credenciais são entregues automaticamente mas o acesso
  // exige um código gerado pelo sistema — o cliente solicita via chat.
  // O atendimento para envio do código funciona seg–sex 8h–17h e sáb 8h–14h.
  isManualDelivery        Boolean  @default(false) @map("is_manual_delivery")
  // Quando true, cada seat é uma tela individual com PIN próprio (ex: Netflix).
  // Quando false, a conta não usa telas — apenas email/senha sem PIN (ex: ChatGPT).
  hasScreens              Boolean  @default(true) @map("has_screens")
  // Quando true (apenas para ENGAJAMENTO), o comprador digita os comentários linha
  // a linha — cada linha = 1 unidade. A quantidade é derivada da contagem de linhas.
  acceptsCustomComments   Boolean  @default(false) @map("accepts_custom_comments")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  category         Category          @relation(fields: [categoryId], references: [id])
  platform         Platform          @relation(fields: [platformId], references: [id])
  stockItems       StockItem[]
  orders           Order[]
  reviews          Review[]
  accessUpdateLogs AccessUpdateLog[]

  @@index([categoryId])
  @@index([platformId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  // Posição de exibição das seções de categoria na loja (0 = primeira) —
  // ajustável pelo ADM/FUNC em /admin/categorias, independente da data de criação.
  order     Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?  @map("logo_url")
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("platforms")
}

model StockItem {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  content        String
  // Vaga sem credenciais reais — entrega é feita manualmente pela equipe (ver
  // fulfillDigitalOrder em order.service.js). content fica vazio nesse caso.
  isManual       Boolean   @default(false) @map("is_manual")
  // Quantidade de vagas/telas que a conta compartilhada suporta (ex: 4 telas
  // Netflix), replicado em todo StockItem dessa conta. Ao editar (PUT
  // /stock/items/:id), se o valor enviado for maior que o total de linhas
  // hoje, a diferença é criada como novas vagas disponíveis — repõe uma
  // conta esgotada sem recadastrar as credenciais (ver stock.service.js).
  quantidade     Int       @default(1)
  isSold         Boolean   @default(false) @map("is_sold")
  soldToUserId   String?   @map("sold_to_user_id")
  soldAt         DateTime? @map("sold_at")
  // Pedido que consumiu esta vaga — sem isso não dá pra ligar "quem comprou"
  // (soldToUserId) a um pedido específico quando o mesmo cliente compra o
  // mesmo produto mais de uma vez.
  orderId        String?   @map("order_id")
  pin            String?   @map("pin")
  lastEditedById String?   @map("last_edited_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  product      Product @relation(fields: [productId], references: [id])
  soldToUser   User?   @relation("StockSoldToUser", fields: [soldToUserId], references: [id])
  order        Order?  @relation(fields: [orderId], references: [id])
  lastEditedBy User?   @relation("StockItemLastEditedBy", fields: [lastEditedById], references: [id])

  // Matches the exact filter used to check/reserve available stock at checkout
  // (see order.service.js#createOrder and #fulfillDigitalOrder).
  @@index([productId, isSold])
  @@index([soldToUserId])
  @@map("stock_items")
}

/**
 * One row per broadcast of updated access credentials — "Enviado" is the only real status: chat messages are written synchronously to our own DB, so there's no external delivery/failure state to track (no email/WhatsApp provider integrated).
 */
model AccessUpdateLog {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  content        String
  recipientCount Int      @map("recipient_count")
  sentById       String   @map("sent_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  sentBy  User    @relation(fields: [sentById], references: [id])

  @@map("access_update_logs")
}

model Order {
  id                      String        @id @default(uuid())
  userId                  String        @map("user_id")
  productId               String        @map("product_id")
  quantity                Int           @default(1)
  unitPrice               Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice              Decimal       @map("total_price") @db.Decimal(10, 2)
  discountAmount          Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponCode              String?       @map("coupon_code")
  paymentMethod           PaymentMethod @default(PIX) @map("payment_method")
  paymentStatus           PaymentStatus @default(PENDING) @map("payment_status")
  mercadoPagoPaymentId    String?       @map("mercado_pago_payment_id")
  mercadoPagoQrCode       String?       @map("mercado_pago_qr_code") @db.Text
  mercadoPagoQrCodeBase64 String?       @map("mercado_pago_qr_code_base64") @db.Text
  orderStatus             OrderStatus   @default(PENDING) @map("order_status")
  targetUsername          String?       @map("target_username")
  targetUrl               String?       @map("target_url")
  customComments          String?       @map("custom_comments") @db.Text
  baratosSociaisOrderId   String?       @map("baratos_sociais_order_id")
  // Contagem inicial (seguidores/curtidas/etc.) digitada manualmente pela equipe
  // para pedidos ENGAJAMENTO entregues fora do fluxo automático — quando a Baratos
  // Sociais nunca chegou a criar a ordem, não existe start_count vindo da API.
  manualStartCount        String?       @map("manual_start_count")
  deliveredContent        String?       @map("delivered_content") @db.Text
  customerLastReadAt      DateTime?     @map("customer_last_read_at")
  staffLastReadAt         DateTime?     @map("staff_last_read_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  transactions Transaction[]
  chatMessages ChatMessage[]
  stockItems   StockItem[]

  @@index([userId])
  @@index([productId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE) @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxUses       Int?         @map("max_uses")
  usesCount     Int          @default(0) @map("uses_count")
  validFrom     DateTime?    @map("valid_from")
  validUntil    DateTime?    @map("valid_until")
  isActive      Boolean      @default(true) @map("is_active")
  createdBy     String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  creator User? @relation("CouponCreatedBy", fields: [createdBy], references: [id])

  @@map("coupons")
}

model Transaction {
  id          String          @id @default(uuid())
  orderId     String?         @map("order_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("transactions")
}

model ChatMessage {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  sender     ChatSender
  message    String
  isDelivery Boolean    @default(false) @map("is_delivery")
  createdAt  DateTime   @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("chat_messages")
}

/**
 * Contas próprias da agência usadas para revenda de acesso compartilhado (ex:
 * as N contas do ChatGPT que a equipe possui) — distinto de StockItem, que
 * modela vagas já atreladas a um Product/venda. Aqui é só um painel de
 * controle manual do ADM sobre credenciais e ocupação, sem ligação com pedidos.
 */
model SharedAccount {
  id              String    @id @default(uuid())
  platformName    String    @map("platform_name")
  label           String?
  email           String
  // Criptografado (AES-256-GCM, ver src/utils/crypto.js) — nunca texto puro no
  // banco, mas recuperável para exibição ao ADM (não é hash).
  passwordEnc     String    @map("password_enc")
  // Data do último pagamento do plano. Null até o primeiro pagamento ser registrado.
  lastPaymentDate DateTime? @map("last_payment_date")
  // Data de vencimento da próxima cobrança — cadastrada manualmente pelo ADM
  // (não é derivada de lastPaymentDate, já que o ciclo pode variar).
  dueDate         DateTime? @map("due_date")
  loggedInCount   Int       @default(0) @map("logged_in_count")
  notes           String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("shared_accounts")
}

model Review {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  userId         String    @map("user_id")
  rating         Int
  comment        String?
  adminReply     String?   @map("admin_reply")
  adminRepliedAt DateTime? @map("admin_replied_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}
