# Database (Neon - PostgreSQL serverless)
DATABASE_URL="postgresql://user:pass@neon-host/db?sslmode=require"

# Google OAuth (login social)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"

# JWT
# NUNCA use os valores abaixo como estão — são só ilustrativos. Gere segredos
# fortes e distintos por ambiente com: openssl rand -hex 32
# O servidor recusa iniciar (ver src/config/validateEnv.js) se algum destes
# faltar, tiver menos de 32 caracteres, ou for um valor de exemplo conhecido.
JWT_SECRET="CHANGE_ME_run__openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_run__openssl_rand_hex_32_again"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Mercado Pago
MP_ACCESS_TOKEN="TEST-xxx"
MP_WEBHOOK_SECRET="webhook-secret"
MP_WEBHOOK_URL="https://api.seudominio.com/webhooks/mercado-pago"
MP_STATEMENT_DESCRIPTOR="HYPEFY"

# Baratos Sociais
BARATOS_SOCIAIS_API_KEY="your-baratos-sociais-api-key"
BARATOS_SOCIAIS_BASE_URL="https://baratosociais.com/api/v2"

# WhatsApp de suporte — usado na mensagem automática de pedidos com entrega
# manual (só DDI+DDD+número, sem "+" nem espaços, ex: 55DDNNNNNNNNN)
SUPPORT_WHATSAPP_NUMBER="5534998262737"

# Cloudflare R2
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="hypefy-images"
R2_PUBLIC_URL="https://xxx.r2.dev"

# Email (forgot password + notificação do DPO em solicitações LGPD)
# Envio via API HTTP do Brevo (não SMTP) — gere em Brevo > SMTP & API > API Keys
DPO_EMAIL="dpo@hypefy.com"
BREVO_API_KEY="xkeysib-xxx"
SMTP_FROM="Hypefy Agência <no-reply@hypefy.com>"
FRONTEND_URL="https://hypefychatgpt.vercel.app"

# App
PORT=3000
NODE_ENV=development

# Origens permitidas para CORS (separadas por vírgula). Sem isso, cai no
# fallback de FRONTEND_URL — nunca deixe em branco em produção.
CORS_ALLOWED_ORIGINS="https://hypefychatgpt.vercel.app"

# Seed (usuário ADM inicial)
SEED_ADMIN_EMAIL="admin@hypefy.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Criptografia reversível das senhas de contas compartilhadas (controle de
# contas do admin) — 32 bytes em hex, gerado com: openssl rand -hex 32
ACCOUNT_SECRET_KEY="CHANGE_ME_run__openssl_rand_hex_32"
